# GapFinder AI — environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# With nothing set, the app runs in clearly labelled DEMO MODE (no auth, no database, no AI calls).

# auto (default) = live if all three Supabase variables are set, otherwise demo.
# demo = always demo. live = require Supabase (falls back to demo with a warning if missing).
APP_MODE=auto

# --- Supabase (enables real auth + database persistence) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to write grades/answer keys and manage storage. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (enables question generation, AI grading, embeddings) ---
# Only used in live mode. Without it, live mode uses stored questions, a key-point rubric
# for short answers, Postgres full-text retrieval and extractive tutor answers.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Requested at 768 dimensions; must match vector(768) in the SQL migration.
EMBEDDING_MODEL=gemini-embedding-001

# --- Judge / demo account (optional, live mode only) ----------------------
# Create the account with `npm run demo-user`. The password never reaches the browser:
# the login page offers a one-click "judge" button that signs in on the server.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
